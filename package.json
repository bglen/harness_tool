{
  "name": "harness-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "data:build": "tsx scripts/data-build/index.ts",
    "dev": "pnpm data:build && pnpm --filter @hs/web dev",
    "build": "pnpm data:build && turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @hs/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
